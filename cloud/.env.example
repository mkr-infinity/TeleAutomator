# =============================================================================
# Cloud Deployment Environment Configuration (.env)
# =============================================================================
# Copy this file to cloud/.env and configure your secrets.
# =============================================================================

# 1. Telegram API Credentials
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# 2. Cloud Session Configuration
# Generate your StringSession locally using: python3 scripts/generate_session.py
TG_SESSION_MODE=string
TG_SESSION_STRING=paste_your_exported_string_session_here

# 3. Target Chats Allowlist (HOW TO ENTER CHAT IDs)
# - Comma-separated integer IDs of allowed private contacts or groups.
# - Example: ALLOWED_PRIVATE_CHATS=123456789,987654321
# - Groups have negative IDs: ALLOWED_GROUPS=-1001234567890
ALLOWED_PRIVATE_CHATS=123456789
ALLOWED_GROUPS=
BLOCKED_CHATS=
IGNORED_USERS=

# 4. Reply Mode & Automation
# In cloud, "approval" is recommended so you review drafts via Saved Messages.
# Set to "restricted_auto" if you want 24/7 automatic replies.
REPLY_MODE=approval
AUTO_AUTHORIZE=false

# 5. AI Reply Engine (Google Gemini / OpenAI)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# 6. Safety Cooldowns & Limits (Anti-Spam)
GLOBAL_COOLDOWN_SECONDS=30
PER_CHAT_COOLDOWN_SECONDS=60
MAX_MESSAGE_LENGTH=1000

# 7. Container Data Directory (mounted to persistent volume)
DATA_DIR=/app/data
APP_ENV=production
LOG_LEVEL=INFO
