# =============================================================================
# Cloud Deployment Environment Configuration (.env)
# =============================================================================

# Telegram API Credentials
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Cloud Session Configuration (MTProto StringSession)
# Generate this on your local machine using ./local/authenticate.sh
TG_SESSION_MODE=string
TG_SESSION_STRING=paste_your_exported_string_session_here

# Runtime Environment & Logging
APP_ENV=production
LOG_LEVEL=INFO

# Reply Mode:
#   draft           - Generate draft reply and record in database; do not send
#   approval        - Generate draft, notify in Telegram Saved Messages, wait for /approve <id>
#   restricted_auto - Automatically send low-risk replies to allowlisted chats only
REPLY_MODE=approval

# AI Reply Provider Configuration
AI_ENABLED=false
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# Chat & User Filtering (Comma-separated integer IDs)
# Required: The client will only interact with chats explicitly listed here!
ALLOWED_PRIVATE_CHATS=
ALLOWED_GROUPS=
BLOCKED_CHATS=
IGNORED_USERS=

# Rate Limits & Safety (seconds)
GLOBAL_COOLDOWN_SECONDS=30
PER_CHAT_COOLDOWN_SECONDS=60
MAX_MESSAGE_LENGTH=1000

# Container Data Directory (mounted to persistent volume)
DATA_DIR=/app/data
