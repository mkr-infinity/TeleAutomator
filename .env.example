# =============================================================================
# TeleAutomator - Beginner Configuration Guide (.env.example)
# =============================================================================
# HOW TO USE THIS FILE:
# 1. Copy this file to create your own private configuration:
#      cp .env.example .env
# 2. Open .env with any text editor and replace the placeholder values below
#    with your actual credentials.
# 3. Secure your file permissions (recommended on Linux/macOS):
#      chmod 600 .env
#
# NOTE: Never share or commit your '.env' file! Keep your keys private.
# =============================================================================


# =============================================================================
# 1. TELEGRAM API CREDENTIALS (Required)
# =============================================================================
# TeleAutomator connects directly to Telegram using MTProto.
# How to get your API credentials:
#   1. Visit https://my.telegram.org in your web browser.
#   2. Log in with your Telegram phone number and enter the confirmation code.
#   3. Click on "API development tools".
#   4. Enter an app title (e.g. TeleAutomator) and short name (e.g. teleautomator).
#   5. Copy your 'api_id' (number) and 'api_hash' (32-character hex string).

TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef


# =============================================================================
# 2. SESSION MODE (Where your login session is stored)
# =============================================================================
# Options:
#   "local"  - (Recommended for beginners, PC, or VPS)
#              Saves your encrypted login session to 'data/telegram_client.session'.
#              You log in once via terminal (./authenticate.sh) and stay logged in.
#
#   "string" - (For headless cloud platforms like Railway, Render, Docker)
#              Stores your session as a single encrypted string in TG_SESSION_STRING.
#              Generate it once on your PC using './session.sh', then paste it below.

TG_SESSION_MODE=local
TG_SESSION_NAME=telegram_client
TG_SESSION_STRING=


# =============================================================================
# 3. CHAT ALLOWLIST & ACCESS CONTROL (Who can receive automated replies)
# =============================================================================
# Controls which chats TeleAutomator is allowed to reply to.
# - Private DM Chat IDs are positive numbers (e.g. 123456789).
# - Group & Supergroup Chat IDs are negative numbers starting with -100 (e.g. -1001234567890).
#
# TIP: You can leave these blank initially! You can dynamically allow chats right
# from your Telegram phone by texting '/allowchat <id>' to your Saved Messages.

ALLOWED_PRIVATE_CHATS=
ALLOWED_GROUPS=
BLOCKED_CHATS=
IGNORED_USERS=


# =============================================================================
# 4. OPERATING MODE & REMOTE CONTROL
# =============================================================================
# Options:
#   "draft"           - Suggests and logs AI draft replies to SQLite; NEVER sends to Telegram.
#   "approval"        - Sends draft replies to your Telegram 'Saved Messages'.
#                       You review them and reply '/approve <id>' to dispatch.
#   "restricted_auto" - (Default) Automatically replies to allowlisted chats with human delays.
#
# AUTO_AUTHORIZE=true lets you manage your bot from your Telegram Saved Messages
# using commands like /status, /mode, /allowchat, /syncpins, /setai, and /backup.

REPLY_MODE=restricted_auto
AUTO_AUTHORIZE=true


# =============================================================================
# 5. AI REPLY ENGINE (Choose Google Gemini, OpenAI, or Custom Provider)
# =============================================================================
# AI_ENABLED:
#   true  - AI crafts context-aware human-like replies.
#   false - Operates purely on keyword rules and safe canned responses without AI.
AI_ENABLED=true

# AI_PROVIDER:
#   Options: "gemini", "openai", "custom", "groq", "nvidia", "local"
#   - "gemini": Uses Google Gemini API (Get free key at https://aistudio.google.com/app/apikey)
#   - "openai": Uses OpenAI official API (https://platform.openai.com/api-keys)
#   - "custom": Any OpenAI-compatible endpoint (InceptionLabs Mercury, Together AI, Ollama, etc.)
AI_PROVIDER=gemini

# AI_BASE_URL:
#   - Leave blank or omit if using standard Gemini or OpenAI.
#   - If using "custom", enter your provider's OpenAI-compatible base URL.
#     Example: https://api.your-provider.com/v1
AI_BASE_URL=

# AI_API_KEY:
#   Enter your private AI API key from your chosen provider.
#   Example for Gemini: AIzaSy...
#   Example for OpenAI or custom: sk-...
AI_API_KEY=your_api_key_here

# AI_MODEL:
#   Name of the model to use. You can specify fallback models separated by commas.
#   Examples:
#     For Gemini: gemini-2.5-flash,gemini-2.5-pro
#     For OpenAI: gpt-4o-mini,gpt-4o
#     For Custom: your-model-name-here
AI_MODEL=gemini-2.5-flash

# REASONING_EFFORT:
#   Reasoning effort for reasoning models (e.g. Mercury, o1, o3-mini).
#   Options: "low", "medium", "high", "off" (Default: "low")
REASONING_EFFORT=low


# =============================================================================
# 6. HUMAN-LIKE TIMING & SAFETY DELAYS (Anti-Spam & Anti-Ban)
# =============================================================================
# TeleAutomator simulates authentic human texting speed so your account is safe.
#
# MIN_REPLY_DELAY_SECONDS / MAX_REPLY_DELAY_SECONDS:
#   Random delay between reading a message and replying (seconds).
#   Groups are answered faster (5-25s); private DMs are more relaxed (10-60s).
MIN_REPLY_DELAY_SECONDS=5
MAX_REPLY_DELAY_SECONDS=60

# TYPING_DELAY_SECONDS:
#   Shows "typing..." status in Telegram before sending, just like a real person.
TYPING_DELAY_SECONDS=2

# GLOBAL_COOLDOWN_SECONDS & PER_CHAT_COOLDOWN_SECONDS:
#   Prevents back-to-back spamming. Minimum seconds before replying again.
GLOBAL_COOLDOWN_SECONDS=30
PER_CHAT_COOLDOWN_SECONDS=60
MAX_MESSAGE_LENGTH=1000

# DEFAULT_CHAT_LANGUAGE:
#   Default language for all AI generated replies. Defaults to "english".
#   Options: "english", "dynamic", "hindi", or any specific language name.
DEFAULT_CHAT_LANGUAGE=english

# Emoji Reaction Randomized Delay (seconds):
REACTION_MIN_COOLDOWN_SECONDS=3
REACTION_MAX_COOLDOWN_SECONDS=9

# Quiet Hours (Simulates a human sleep schedule - pauses replies automatically):
# Enabled by default from 02:00 to 08:00 Indian Standard Time (IST, UTC+05:30).
# Before quiet hours start, TeleAutomator sends a natural casual goodnight sign-off to active groups.
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=02:00
QUIET_HOURS_END=08:00


# =============================================================================
# 7. SENSITIVE WORDS & PRIVACY FILTER
# =============================================================================
# Comma-separated words that trigger immediate privacy alerts and halt AI replies.
SENSITIVE_KEYWORDS=otp,password,passcode,secret,cvv,pin,private key,seed phrase


# =============================================================================
# 8. ENVIRONMENT & DATA STORAGE
# =============================================================================
# SQLite database, backups, and sessions are safely stored inside DATA_DIR.
# Git ignores this directory so updating your code will never erase your data.
APP_ENV=production
LOG_LEVEL=INFO
DATA_DIR=data
