# =============================================================================
# TeleAutomator - Telegram Chat Automation Unified Configuration (.env)
# =============================================================================
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# 1. Telegram API Credentials (Obtain from https://my.telegram.org/apps)
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# 2. MTProto Session Mode
# Options:
#   "local"  - Uses a secure local file session (.session) in data/ directory.
#              Best for Linux/macOS laptops, Windows, or VPS with terminal access.
#   "string" - Uses an encrypted Telethon StringSession stored in TG_SESSION_STRING.
#              Best for headless Docker containers and cloud deployments.
TG_SESSION_MODE=local
TG_SESSION_NAME=telegram_client
TG_SESSION_STRING=

# 3. Target Chats Allowlist (Controls which chats are monitored)
# - To find a chat ID: check terminal logs when a message arrives, or forward to @userinfobot.
# - Users/Private chats: positive numbers (e.g., 123456789)
# - Groups/Channels: negative numbers starting with -100 (e.g., -1001234567890)
# - Leave empty to disallow all incoming replies until explicitly allowed via /allowchat <id>.
ALLOWED_PRIVATE_CHATS=
ALLOWED_GROUPS=
BLOCKED_CHATS=
IGNORED_USERS=

# 4. Reply Mode & Remote Control
# Options:
#   "draft"           - Suggests replies in terminal logs; NEVER sends automatically.
#   "approval"        - Sends draft to your Telegram Saved Messages; send /approve <id> to dispatch.
#   "restricted_auto" - Directly replies to allowlisted chats without approval.
REPLY_MODE=restricted_auto
AUTO_AUTHORIZE=true

# 5. AI Reply Engine (Google Gemini)
# AI_ENABLED=true uses Google Gemini AI to craft natural human replies.
# AI_ENABLED=false uses instant keyword rules and safe fallback replies without calling an external API.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash

# 6. Safety Cooldowns & Human-Like Message Delays
# Minimum seconds before replying again globally and per specific chat.
GLOBAL_COOLDOWN_SECONDS=30
PER_CHAT_COOLDOWN_SECONDS=60
MAX_MESSAGE_LENGTH=1000

# Randomized Human Delay (5 to 60 seconds):
# Adapts to group chats (faster: 5-25s) vs private DMs (relaxed: 10-60s) and message length.
MIN_REPLY_DELAY_SECONDS=5
MAX_REPLY_DELAY_SECONDS=60
TYPING_DELAY_SECONDS=2

# 7. Sensitive Word Redaction & Filters (Comma-separated)
SENSITIVE_KEYWORDS=otp,password,passcode,secret,cvv,pin,private key,seed phrase

# 8. Environment & Storage
APP_ENV=production
LOG_LEVEL=INFO
DATA_DIR=data
