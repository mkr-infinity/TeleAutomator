# =============================================================================
# Telegram Personal MTProto Client - Configuration Template (.env)
# =============================================================================
# Copy this file to .env and fill in your values.
# To find your personal Telegram API credentials, visit: https://my.telegram.org/apps
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Telegram API Credentials (Required)
# -----------------------------------------------------------------------------
# Your Telegram numeric App api_id (e.g., 12345678)
TG_API_ID=

# Your Telegram 32-character App api_hash hex string
TG_API_HASH=

# -----------------------------------------------------------------------------
# 2. Session Handling
# -----------------------------------------------------------------------------
# TG_SESSION_MODE:
#   "local"  - Uses local SQLite session file stored in data/ (for laptop)
#   "string" - Uses Telethon StringSession (for cloud/Docker VPS deployment)
TG_SESSION_MODE=local
TG_SESSION_NAME=telegram_client

# TG_SESSION_STRING:
# If TG_SESSION_MODE=string, paste the exported string session here.
# Generate it locally by running: python3 scripts/generate_session.py
TG_SESSION_STRING=

# -----------------------------------------------------------------------------
# 3. Target Chats Allowlist & Filters (HOW TO ENTER CHAT IDs)
# -----------------------------------------------------------------------------
# For safety, the client ONLY interacts with chats listed in these allowlists.
# All other chats are completely ignored.
#
# HOW TO FIND A CHAT ID:
#   Option A: When someone messages you, check the client console logs:
#             It will print: "Chat: 'Bob' (123456789)" -> 123456789 is the Chat ID.
#   Option B: Forward any message from the user to @userinfobot in Telegram.
#   Option C: For groups, group IDs are usually negative numbers (e.g., -1001234567890).
#
# Comma-separated list of allowed user/chat IDs:
ALLOWED_PRIVATE_CHATS=123456789,987654321

# Comma-separated list of allowed group IDs:
ALLOWED_GROUPS=-1001234567890

# Chats or users you want to explicitly block/ignore:
BLOCKED_CHATS=
IGNORED_USERS=

# -----------------------------------------------------------------------------
# 4. Reply Mode & Auto-Answering
# -----------------------------------------------------------------------------
# REPLY_MODE options:
#   "draft"           - (Default) Generates suggested reply and logs it; NEVER sends.
#   "approval"        - Sends draft to your Telegram "Saved Messages". You review and
#                       send "/approve <id>" to dispatch it, or "/reject <id>" to drop it.
#   "restricted_auto" - Automatically sends replies to allowlisted chats without asking!
REPLY_MODE=draft

# AUTO_AUTHORIZE:
# If true and REPLY_MODE=restricted_auto, auto-answering is active immediately on boot.
# If false, you can activate it anytime from Telegram by sending "/auto on" to Saved Messages.
AUTO_AUTHORIZE=false

# -----------------------------------------------------------------------------
# 5. AI Reply Engine (Google Gemini / OpenAI)
# -----------------------------------------------------------------------------
# Set AI_ENABLED=true to connect real AI (instead of offline template drafts).
AI_ENABLED=false

# AI_PROVIDER options:
#   "gemini" - Google Gemini (Recommended: fast, generous free tier via AI Studio)
#   "openai" - OpenAI GPT (e.g. gpt-4o-mini)
#   "local"  - Built-in offline rule templates (zero external network requests)
AI_PROVIDER=gemini

# Your API Key (from https://aistudio.google.com/app/apikey or https://platform.openai.com)
AI_API_KEY=

# Model name:
# For Gemini: gemini-1.5-flash (default, recommended), gemini-2.0-flash
# For OpenAI: gpt-4o-mini, gpt-4o
AI_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# 6. Safety Cooldowns & Limits (Anti-Spam)
# -----------------------------------------------------------------------------
# Global cooldown (seconds): Minimum waiting time between any two outgoing replies
GLOBAL_COOLDOWN_SECONDS=30

# Per-chat cooldown (seconds): Minimum time before replying to the same chat again
PER_CHAT_COOLDOWN_SECONDS=60

# Maximum character length for any outgoing reply
MAX_MESSAGE_LENGTH=1000

# -----------------------------------------------------------------------------
# 7. Environment & Paths
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
