# =============================================================================
# Root / Local Environment Template
# =============================================================================

TG_API_ID=
TG_API_HASH=

TG_SESSION_MODE=local
TG_SESSION_NAME=telegram_client
TG_SESSION_STRING=

APP_ENV=development
LOG_LEVEL=INFO

# Reply Mode:
#   draft           - Generate draft reply and log locally; do not send (default)
#   approval        - Generate draft, notify in Saved Messages, wait for /approve <id>
#   restricted_auto - Automatically send low-risk replies to allowlisted chats
REPLY_MODE=draft
AUTO_AUTHORIZE=false

# AI Reply Provider Configuration
# Set AI_ENABLED=true to connect real AI (Google Gemini or OpenAI)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

ALLOWED_PRIVATE_CHATS=
ALLOWED_GROUPS=
BLOCKED_CHATS=
IGNORED_USERS=

GLOBAL_COOLDOWN_SECONDS=30
PER_CHAT_COOLDOWN_SECONDS=60
MAX_MESSAGE_LENGTH=1000

DATA_DIR=data
