# =============================================================================
# Local Deployment Environment Configuration (.env)
# =============================================================================

# Telegram API Credentials (from https://my.telegram.org/apps)
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Local Session Configuration
TG_SESSION_MODE=local
TG_SESSION_NAME=telegram_client
TG_SESSION_STRING=

# Runtime Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO

# Reply Mode:
#   draft           - Generate draft reply and log locally; do not send (default)
#   approval        - Generate draft, notify in Saved Messages, wait for /approve <id>
#   restricted_auto - Automatically send low-risk replies to allowlisted chats only
REPLY_MODE=draft
AUTO_AUTHORIZE=false

# AI Reply Provider Configuration
# Set AI_ENABLED=true and configure your Google Gemini API Key
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Chat & User Filtering (Comma-separated integer IDs)
# IMPORTANT: Explicit allowlist. Client ignores any chat not listed here!
# Example: ALLOWED_PRIVATE_CHATS=123456789,987654321
ALLOWED_PRIVATE_CHATS=
ALLOWED_GROUPS=
BLOCKED_CHATS=
IGNORED_USERS=

# Rate Limits & Safety (seconds)
GLOBAL_COOLDOWN_SECONDS=30
PER_CHAT_COOLDOWN_SECONDS=60
MAX_MESSAGE_LENGTH=1000

# Private Local Data Directory
DATA_DIR=data
