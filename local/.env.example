# =============================================================================
# Local Deployment Environment Configuration (.env)
# =============================================================================
# Copy this file to .env and configure your values.
# =============================================================================

# 1. Telegram API Credentials (https://my.telegram.org/apps)
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# 2. Local Session Configuration
TG_SESSION_MODE=local
TG_SESSION_NAME=telegram_client
TG_SESSION_STRING=

# 3. Target Chats Allowlist (HOW TO ENTER CHAT IDs)
# The client only processes messages from chats listed here.
# - To find a chat ID: check the terminal logs when a message arrives (it prints the ID)
#   or forward a message to @userinfobot on Telegram.
# - Groups typically have negative IDs (e.g., -1001234567890).
# - Separate multiple IDs with commas.
ALLOWED_PRIVATE_CHATS=123456789
ALLOWED_GROUPS=
BLOCKED_CHATS=
IGNORED_USERS=

# 4. Reply Mode & Automation
# Options:
#   "draft"           - Suggests drafts in terminal & logs; never sends.
#   "approval"        - Sends draft to your Telegram Saved Messages; send /approve <id> to send.
#   "restricted_auto" - Automatically replies to allowlisted chats without approval.
REPLY_MODE=draft
AUTO_AUTHORIZE=false

# 5. AI Reply Engine (Google Gemini / OpenAI)
# Set AI_ENABLED=true and add your Gemini API Key to enable real AI replies
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# 6. Safety Cooldowns & Limits (Anti-Spam)
GLOBAL_COOLDOWN_SECONDS=30
PER_CHAT_COOLDOWN_SECONDS=60
MAX_MESSAGE_LENGTH=1000

# 7. Environment & Paths
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
