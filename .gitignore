# =============================================================================
# TeleAutomator - Git Ignore Rules
# =============================================================================

# Environment and secrets (Never commit live credentials)
.env
.env.*
!.env.example

# Telegram sessions and SQLite databases
*.session
*.session-journal
*.sqlite
*.sqlite3
*.db
*.db-journal
*.bak

# Python artifacts and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.eggs/

# Application runtime data, logs, and process files
logs/
data/
backups/
*.log
nohup.out

# Editor, OS, and temporary files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
